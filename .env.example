# Fichier d'exemple pour la configuration de l'environnement.
# Renommez ce fichier en .env et remplissez les valeurs appropriées.

# --- Configuration Générale ---
# Service LLM par défaut (OpenAI, Azure, OpenRouter)
GLOBAL_LLM_SERVICE="OpenAI"

# Phrase secrète pour le chiffrement
TEXT_CONFIG_PASSPHRASE="une_phrase_secrete_robuste"

# --- Clés API ---
# Remplissez UNIQUEMENT les clés pour les services que vous utilisez.

# Pour OpenAI (primary)
OPENAI_API_KEY="sk-..."
OPENAI_CHAT_MODEL_ID="gpt-5.6-luna"
# BASE_URL="" # Override OpenAI base URL if needed

# --- Determinism (for measurement runs) ---
# Set LLM_DETERMINISTIC_MODE=1 to enable temperature=0 + seed=42 for
# reproducible extraction runs (benchmark, measurement, soutenance demo).
# Fine-grained overrides (take precedence over the shorthand):
# LLM_TEMPERATURE=0.0
# LLM_SEED=42
# LLM_DETERMINISTIC_MODE=""
#
# Reasoning models (gpt-5*, o1*, o3*) reject temperature/seed with a 400.
# When such a model is detected, determinism params are suppressed automatically.
# To force sending them anyway (you know your endpoint accepts them):
# LLM_FORCE_SAMPLING_PARAMS=1

# Pour OpenRouter (alternative provider — bascule de secours si quota OpenAI épuisé)
# Définir les 2 vars ci-dessous active automatiquement le routage via OpenRouter
# (compatible OpenAI). Retirer OPENROUTER_BASE_URL pour revenir à OpenAI.
# Le slug modèle doit être préfixé par le provider (ex. "openai/gpt-5.6-luna").
# OPENROUTER_API_KEY="sk-or-v1-..."
# OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
# OPENROUTER_CHAT_MODEL_ID="openai/gpt-5.6-luna"

# Pour Azure OpenAI
# AZURE_OPENAI_ENDPOINT="https://your-azure-endpoint.openai.azure.com/"
# AZURE_OPENAI_API_KEY="your-azure-api-key"
# AZURE_OPENAI_API_VERSION="2024-02-15-preview"

# --- Endpoints locaux (pour text-generation-webui, vLLM ou similaire) ---
# Chaque tier numerote a QUATRE variables, pas trois (#2151).
#   OPENAI_ENDPOINT_NAME_i -> libelle lu par un humain (rapports, tableaux)
#   OPENAI_MODEL_ID_i      -> identifiant envoye a l'API dans le champ "model"
# Les deux ont longtemps ete confondus : le libelle partait comme identifiant,
# et l'endpoint repondait 404 "The model ... does not exist" alors que la cle et
# l'URL etaient valides. Sans OPENAI_MODEL_ID_i le registre retombe sur le
# libelle en le signalant par un warning nomme.
# Pour connaitre l'identifiant reellement servi : GET <base_url>/models
# OPENAI_ENDPOINT_NAME_2="Local Model - Micro"
# OPENAI_MODEL_ID_2="nom-exact-du-modele-servi"
# OPENAI_API_KEY_2="votre_cle_locale"
# OPENAI_BASE_URL_2="http://127.0.0.1:5001/v1"
# OPENAI_ENDPOINT_NAME_3="Local Model - Medium"
# OPENAI_MODEL_ID_3="nom-exact-du-modele-servi"
# OPENAI_API_KEY_3="votre_cle_locale"
# OPENAI_BASE_URL_3="http://127.0.0.1:5002/v1"
# OPENAI_ENDPOINT_NAME_4="Local Model - Large"
# OPENAI_MODEL_ID_4="nom-exact-du-modele-servi"
# OPENAI_API_KEY_4="votre_cle_locale"
# OPENAI_BASE_URL_4="http://127.0.0.1:5003/v1"

# --- Services externes ---
# Apache Tika (extraction de texte depuis PDF/DOCX)
# TIKA_SERVER_ENDPOINT="http://localhost:9998"
# TIKA_SERVER_TIMEOUT="30"

# Stable Diffusion (génération d'images)
# SD_BASE_URL="http://localhost:7860"

# --- Self-hosted LLM endpoints (#297) ---
# Used by fallacy detection and other local inference tasks.
# Models may change over time; query /v1/models to discover current models.
SELF_HOSTED_LLM_ENDPOINT="https://your-self-hosted-endpoint.example.com/v1"
SELF_HOSTED_LLM_API_KEY="your-key-here"
# Leave SELF_HOSTED_LLM_MODEL unset unless you actually run the endpoint above.
# When unset, the self-hosted wide-net tier reports degraded (#1275) and the
# main fallacy wide-net uses the central OPENROUTER/OPENAI model instead — no
# rot-prone placeholder id shipped here. If you run the endpoint, set this to a
# model IT serves (verify via GET {ENDPOINT}/models); a wrong id silently 404s.
# SELF_HOSTED_LLM_MODEL="a-model-your-endpoint-actually-serves"
SELF_HOSTED_LLM_MINI_ENDPOINT="https://your-self-hosted-mini-endpoint.example.com/v1"
SELF_HOSTED_LLM_MINI_API_KEY="your-key-here"
SELF_HOSTED_LLM_MINI_MODEL="omnicoder-9b"

# --- Dépendances Systèmes ---
# Laisser vide pour utiliser le JDK portable ou si Java est dans le PATH
JAVA_HOME=""

# Environnement Conda (utilisé par les scripts)
CONDA_ENV_NAME="projet-is-roo-new"
# CONDA_PATH="" # Override path vers Conda si non dans le PATH

# --- Tests E2E ---
# Utilisé par Playwright, peut être laissé par défaut.
FRONTEND_URL="http://localhost:3000"
BACKEND_URL="http://localhost:8000"

# --- Democratech demo (DT-2 #1499 / DT-3 #1499) ---
# The one-command entrypoint (examples/democratech_deliberation/run_democratech_demo_one_command.py)
# picks its mode automatically:
#
#   - LIVE mode (real LLM agents, ~150-200 s/proposition):
#       requires OPENAI_API_KEY below, OR (OPENROUTER_API_KEY + OPENROUTER_BASE_URL)
#       from the "Clés API" section above. Verdict marked decided_firsthand=True.
#
#   - SNAPSHOT mode (replay of a pre-recorded run, <1 s):
#       if no LLM key is set, the entrypoint looks for a snapshot JSON at:
#         1. --snapshot <path> (explicit CLI override)
#         2. ./prerecorded_snapshot.json (cwd)
#         3. ~/.cache/democratech/prerecorded_snapshot.json (user cache)
#       Verdict marked decided_firsthand="PRE-RECORDED" (never True).
#       To generate a snapshot from a successful LIVE run:
#         python examples/democratech_deliberation/run_democratech_demo.py --json \
#           > prerecorded_snapshot.json
#
#   - Exit 2 if neither mode is available. The entrypoint NEVER invents a verdict.
#
# Required for the LIVE mode (already documented above — same vars):
#   OPENAI_API_KEY=sk-...
#   OPENROUTER_API_KEY=sk-or-v1-...   (alternative, set with OPENROUTER_BASE_URL)
#   OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
#
# Demo propositions are synthetic, domain-public (chess club, library, ...).
# No corpus, no `raw_text`, opaque IDs (prop_A..prop_E) on all output.

# ============================================================
# Variables presentes sur les sieges reels mais jusqu ici non
# documentees ici (derive relevee 2026-09-11). Valeurs factices.
# ============================================================
# Surcharge de base OpenAI (passerelle/proxy). Vide = API publique.
OPENAI_BASE_URL="https://api.openai.com/v1"
# Organisation OpenAI, optionnel.
OPENAI_ORG_ID="org-xxxxxxxx"
# PAT GitHub. Compte jsboigeEpita requis pour les ecritures sur ce depot.
GH_TOKEN="ghp_xxxxxxxxxxxxxxxxxxxx"
# DEBUG|INFO|WARNING|ERROR
LOG_LEVEL="INFO"
# true active les traces verbeuses.
DEBUG="false"

# NOTE 2026-09-11 : les services self-hosted mini et micro ne repondent
# pas (timeout/502). Ne renseigner SELF_HOSTED_LLM_MINI_* que lorsqu ils
# sont revenus, sinon on cable un chemin d echec.

# --- Endpoints vLLM locaux (VLLM_ENDPOINT_i_*) ---
# Famille lue par argumentation_analysis/evaluation/model_registry.py (i de 1 a 9),
# jusqu ici absente de ce fichier : aucun siege ne pouvait la renseigner en
# suivant le template. Les noms sont construits en f-string cote code, donc un
# grep litteral ne les trouve pas -- c est ce qui a permis a l oubli de durer.
#
# L enregistrement est conditionne a _URL ET _MODEL : sans les deux, le tier
# n est pas enregistre du tout (pas d erreur, il n existe simplement pas).
#
# ATTENTION _KEY : son defaut est la chaine "not-needed". Un endpoint qui exige
# une authentification repond alors 401 pendant qu une sonde /health non
# authentifiee repond 200 -- le tier se lit comme vivant et echoue a l appel.
# Renseigner _KEY des que l endpoint est protege, meme si le defaut "marche".
# VLLM_ENDPOINT_1_URL="http://127.0.0.1:8000/v1"
# VLLM_ENDPOINT_1_MODEL="nom-exact-du-modele-servi"
# VLLM_ENDPOINT_1_NAME="vLLM - local"
# VLLM_ENDPOINT_1_KEY="votre_cle_si_l_endpoint_est_protege"
